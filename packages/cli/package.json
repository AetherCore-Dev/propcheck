{
  "name": "propcheck",
  "version": "0.1.0",
  "description": "AI-powered property-based testing — find bugs your tests miss",
  "main": "dist-bundle/index.js",
  "types": "dist-bundle/index.d.ts",
  "bin": {
    "propcheck": "dist-bundle/index.js"
  },
  "scripts": {
    "build": "tsc --build",
    "bundle": "tsup",
    "clean": "tsc --build --clean",
    "dev": "tsc --build --watch",
    "prepublishOnly": "npm run build && npm run bundle"
  },
  "keywords": [
    "property-based-testing",
    "pbt",
    "fuzzing",
    "ai",
    "testing",
    "llm",
    "fast-check",
    "hypothesis",
    "property-testing",
    "invariant",
    "claude"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/allenenli/propcheck"
  },
  "homepage": "https://github.com/allenenli/propcheck#readme",
  "dependencies": {
    "@anthropic-ai/sdk": ">=0.50.0",
    "chalk": "^4.1.2",
    "commander": "^13.0.0",
    "zod": "^3.24.0"
  },
  "files": [
    "dist-bundle",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "fast-check": ">=3.0.0",
    "typescript": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "fast-check": {
      "optional": false
    },
    "typescript": {
      "optional": true
    }
  },
  "license": "MIT"
}
