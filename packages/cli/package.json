{
  "name": "propcheck",
  "version": "0.1.0",
  "description": "AI-powered property-based testing — find bugs your tests miss",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "propcheck": "dist/index.js"
  },
  "scripts": {
    "build": "tsc --build",
    "clean": "tsc --build --clean",
    "dev": "tsc --build --watch"
