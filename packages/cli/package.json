  "dependencies": {
    "@propcheck/common": "*",
    "@propcheck/config": "*",
    "@propcheck/parser": "*",
    "@propcheck/store": "*",
    "@propcheck/llm": "*",
    "@propcheck/engines": "*",
    "@propcheck/reporter": "*",
    "commander": "13.1.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT"
}
