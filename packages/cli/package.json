{
  "name": "propcheck",
  "version": "0.4.4",
  "description": "AI-powered property-based testing — find bugs your tests miss",
  "main": "dist-bundle/index.js",
  "bin": {
    "propcheck": "dist-bundle/index.js"
  },
  "scripts": {
    "build": "tsc --build",
    "bundle": "tsup",
    "clean": "tsc --build --clean",
    "dev": "tsc --build --watch",
    "test": "node --test dist/**/*.test.js",
    "prepublishOnly": "npm run build && npm run bundle"
  },
  "keywords": [
    "property-based-testing",
    "pbt",
    "fuzzing",
    "ai",
    "testing",
    "llm",
    "fast-check",
    "hypothesis",
    "property-testing",
    "invariant",
    "claude"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AetherCore-Dev/propcheck.git"
  },
  "homepage": "https://github.com/AetherCore-Dev/propcheck#readme",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.52.0",
    "chalk": "^4.1.2",
    "commander": "^13.0.0",
    "zod": "^3.24.0"
  },
  "files": [
    "dist-bundle",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "fast-check": ">=4.0.0",
    "typescript": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "fast-check": {
      "optional": false
    },
    "typescript": {
      "optional": true
    }
  },
  "license": "MIT",
  "author": "AetherCore-Dev",
  "engines": {
    "node": ">=18.0.0"
  },
  "bugs": {
    "url": "https://github.com/AetherCore-Dev/propcheck/issues"
  }
}
